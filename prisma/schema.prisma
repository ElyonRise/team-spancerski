generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String?
  role  String @default("client")
}

model Dieta {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
}
