# ─── BANCO DE DADOS (Neon - gratuito) ───────────────────────────────
# Acesse: https://neon.tech → crie projeto → copie a connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── AUTH ────────────────────────────────────────────────────────────
JWT_SECRET="troque_por_uma_string_longa_e_aleatoria_aqui_min32chars"

# ─── IA GROQ (gratuito) ──────────────────────────────────────────────
# Acesse: https://console.groq.com → API Keys → Create Key
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── EMAIL (Gmail gratuito) ──────────────────────────────────────────
# No Gmail: Configurações → Segurança → Senhas de app
EMAIL_USER="seu_email@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Team Spancerski <seu_email@gmail.com>"

# ─── PROFISSIONAL (único admin) ──────────────────────────────────────
PRO_EMAIL="spancerski@email.com"
PRO_PASSWORD_HASH=""   # Gerado automaticamente no primeiro setup

# ─── URL DO APP ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
